msgstr "Мастерская"

msgid "Avasta"
msgstr "Исследуйте"

msgid "Otsingud"
msgstr "Запросы"

msgid "Toitlustus"
msgstr "Общепит"

msgid "Jaemüük"
msgstr "Ритейл"

msgid "Projektid"
msgstr "Проекты"

msgid "Tellimise protsess"
msgstr "Процесс заказа"

msgid "Pressiportfell"
msgstr "Портфолио прессы"

msgid "Äripindade siseviimistluse, jaemüügikettide laiendamise ja arhitektide koostöö jaoks saatke oma brief otse meie projektide lauale."
msgstr "Для отделки заведений, расширения ритейл-сетей и партнёрства с архитекторами отправьте ваш бриф прямо на наш проектный стол."

msgid "Kõik õigused kaitstud."
msgstr "Все права защищены."

